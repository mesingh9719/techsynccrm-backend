NODE_ENV=development
PORT=5000
# Comma-separated origins allowed to call the API (required in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Neon (filled by `neon deploy` / `neon env pull`) ---
# Pooled connection for the app; unpooled (direct) connection for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Bounded interactive transaction budgets (milliseconds); includes all queries in a write.
DB_TRANSACTION_MAX_WAIT_MS=10000
DB_TRANSACTION_TIMEOUT_MS=15000
NEON_BRANCH=
# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET=assets
MAX_UPLOAD_MB=25

# --- JWT auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
# Use "none" (requires HTTPS) if the frontend and API are on different sites
COOKIE_SAMESITE=lax

# --- Email ---
# Frontend URL used in email links (required in production)
FRONTEND_URL=http://localhost:5173
# SMTP (port 465 = TLS, 587 = STARTTLS). Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, e.g. "TechSync CRM <hello@yourdomain.com>" (defaults to SMTP_USER)
SMTP_FROM=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- Background jobs & logging (M00) ---
# "queue" (default): emails are sent by the worker with retries — run `npm run worker` next to the API.
# "direct": emails are sent inline by the API (handy for local development without a worker).
EMAIL_DELIVERY=queue
# debug | info | warn | error
LOG_LEVEL=
# Optional name for this worker in the health check (when running several)
WORKER_ID=

# --- Marketing forms (M01) ---
# Where contact/demo notifications are sent. SALES_INBOX / SUPPORT_INBOX fall back to HELLO_INBOX,
# which falls back to SMTP_USER.
HELLO_INBOX=
SALES_INBOX=
SUPPORT_INBOX=
# Comma-separated verified staff emails allowed to use the superadmin console and /api/internal
INTERNAL_STAFF_EMAILS=
# Console URL used by the operator-only staff:provision command
SUPERADMIN_URL=http://localhost:5174
# Per-IP submissions per 15 minutes, per form
PUBLIC_FORM_RATE_LIMIT_MAX=10
DEMO_SLOT_CAPACITY=3
DEMO_MAX_DAYS_AHEAD=30
NEWSLETTER_CONFIRM_TTL_DAYS=7

# --- Seed (development only: npm run db:seed) ---
SEED_EMAIL=
SEED_PASSWORD=

# --- Account security (M05) ---
# REQUIRED. 32 random bytes, base64. Encrypts 2FA secrets at rest — never change it once users have 2FA.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
INVITATION_TTL_DAYS=7

# --- Facebook Pages / Lead Ads (optional; backend only) ---
# App settings > Basic. Never put the App Secret in VITE_* variables or frontend code.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set to the Graph/Marketing API version enabled for your Meta app.
FACEBOOK_API_VERSION=v26.0
# Optional Facebook Login for Business configuration ID; choose a User access token configuration.
FACEBOOK_LOGIN_CONFIG_ID=
# Exact public callback registered under Valid OAuth Redirect URIs:
# https://api.example.com/api/integrations/facebook/callback
FACEBOOK_REDIRECT_URI=
# Choose a random secret; use the same value in Meta's Page webhook configuration.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Used when FACEBOOK_LOGIN_CONFIG_ID is empty; Business Login configurations define permissions in Meta.
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_manage_ads,leads_retrieval,ads_read,ads_management,business_management
