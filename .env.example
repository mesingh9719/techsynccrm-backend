NODE_ENV=development
PORT=5000
# Comma-separated origins allowed to call the API (required in production)
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Neon (filled by `neon deploy` / `neon env pull`) ---
# Pooled connection for the app; unpooled (direct) connection for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# Neon Object Storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET=assets
MAX_UPLOAD_MB=25

# --- JWT auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
# Use "none" (requires HTTPS) if the frontend and API are on different sites
COOKIE_SAMESITE=lax

# --- Email ---
# Frontend URL used in email links (required in production)
FRONTEND_URL=http://localhost:5173
# SMTP (port 465 = TLS, 587 = STARTTLS). Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, e.g. "TechSync CRM <hello@yourdomain.com>" (defaults to SMTP_USER)
SMTP_FROM=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_RESEND_COOLDOWN_SECONDS=60

# --- Background jobs & logging (M00) ---
# "queue" (default): emails are sent by the worker with retries — run `npm run worker` next to the API.
# "direct": emails are sent inline by the API (handy for local development without a worker).
EMAIL_DELIVERY=queue
# debug | info | warn | error
LOG_LEVEL=
# Optional name for this worker in the health check (when running several)
WORKER_ID=

# --- Marketing forms (M01) ---
# Where contact/demo notifications are sent. SALES_INBOX / SUPPORT_INBOX fall back to HELLO_INBOX,
# which falls back to SMTP_USER.
HELLO_INBOX=
SALES_INBOX=
SUPPORT_INBOX=
# Comma-separated staff emails allowed to call GET /api/internal/inbound
INTERNAL_STAFF_EMAILS=
# Per-IP submissions per 15 minutes, per form
PUBLIC_FORM_RATE_LIMIT_MAX=10
DEMO_SLOT_CAPACITY=3
DEMO_MAX_DAYS_AHEAD=30
NEWSLETTER_CONFIRM_TTL_DAYS=7

# --- Seed (development only: npm run db:seed) ---
SEED_EMAIL=
SEED_PASSWORD=

# --- Account security (M05) ---
# REQUIRED. 32 random bytes, base64. Encrypts 2FA secrets at rest — never change it once users have 2FA.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15
INVITATION_TTL_DAYS=7
