model Task {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String     @map("organization_id") @db.Uuid
  title                 String
  description           String?
  /// todo | call | meeting | follow_up | email | whatsapp
  type                  String     @default("todo")
  /// low | normal | high
  priority              String     @default("normal")
  status                TaskStatus @default(open)
  dueAt                 DateTime?  @map("due_at") @db.Timestamptz(6)
  /// Due on a date (stored as end of that day in the workspace time zone)
  allDay                Boolean    @default(false) @map("all_day")
  reminderOffsetMinutes Int?       @default(15) @map("reminder_offset_minutes")
  /// When the reminder is due (due_at − offset); recomputed on every change, scanned every minute
  remindAt              DateTime?  @map("remind_at") @db.Timestamptz(6)
  reminderSentAt        DateTime?  @map("reminder_sent_at") @db.Timestamptz(6)
  /// Retained for compatibility with the originally deployed M10 migration. No new jobs use it.
  reminderJobId         String?    @map("reminder_job_id")
  /// { freq: daily|weekly|monthly, interval, byWeekday?, byMonthDay?, count?, until? }
  recurrence            Json?
  /// First task of a recurring series
  seriesId              String?    @map("series_id") @db.Uuid
  /// Linked record: lead | contact | company | deal
  entityType            String?    @map("entity_type")
  entityId              String?    @map("entity_id") @db.Uuid
  assigneeId            String     @map("assignee_id") @db.Uuid
  createdById           String?    @map("created_by_id") @db.Uuid
  completedAt           DateTime?  @map("completed_at") @db.Timestamptz(6)
  completedById         String?    @map("completed_by_id") @db.Uuid
  overdueNotifiedAt     DateTime?  @map("overdue_notified_at") @db.Timestamptz(6)
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, assigneeId, status, dueAt])
  @@index([organizationId, entityType, entityId])
  @@index([status, dueAt])
  @@map("tasks")
}


// ---------- Notifications (M11) ----------
model Notification {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  type String
  title String
  body String?
  entityType String? @map("entity_type")
  entityId String? @map("entity_id") @db.Uuid
  url String?
  actorId String? @map("actor_id") @db.Uuid
  groupCount Int @default(1) @map("group_count")
  sourceEventId String? @map("source_event_id") @db.Uuid
  /// Email-only notifications are stored durably but excluded from the inbox/count.
  inApp Boolean @default(true) @map("in_app")
  context Json @default("{}")
  readAt DateTime? @map("read_at") @db.Timestamptz(6)
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(6)
  emailPendingAt DateTime? @map("email_pending_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId, sourceEventId])
  @@index([organizationId, userId, inApp, readAt, createdAt(sort: Desc)])
  @@index([emailPendingAt])
  @@map("notifications")
}

model NotificationPreference {
