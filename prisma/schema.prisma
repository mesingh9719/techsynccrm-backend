/// Public Meta callback tracking: encrypted subject exists only until processing completes.
model FacebookDeletionRequest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestHash String @unique @map("request_hash")
  confirmationHash String @unique @map("confirmation_hash")
  subjectHash String? @map("subject_hash")
  subjectEnc String? @map("subject_enc")
  cutoffAt DateTime @map("cutoff_at") @db.Timestamptz(6)
  status String @default("queued")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseUntil DateTime? @map("lease_until") @db.Timestamptz(6)
  lastError String? @map("last_error")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([subjectHash, status])
  @@index([status, nextAttemptAt, leaseUntil])
  @@index([completedAt])
  @@map("facebook_deletion_requests")
}
