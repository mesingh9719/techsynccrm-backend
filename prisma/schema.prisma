// Prisma schema — the source of truth for the database.
// Change models here, then run `npm run db:migrate:dev -- --name <change>` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  starter
  growth
  business
  enterprise
}

enum UserTokenType {
  email_verification
  password_reset
  /// Confirms a new email address (sent to the new address). payload: { email }
  email_change
  /// "This wasn't me" link sent to the old address. payload: { oldEmail, newEmail }
  email_change_cancel
  /// Second step of a 2FA login (never emailed). payload: { remember }
  login_challenge
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String    @map("full_name")
  /// Always stored lowercased by the API, so uniqueness is case-insensitive.
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  /// Stable Google identity; email alone is never a provider identity.
  googleSubject   String?   @unique @map("google_subject") @db.VarChar(255)
  /// The plan picked on the pricing/signup page, used when onboarding creates the first workspace
  /// (then cleared). The workspace's plan (organizations.plan) is what applies.
  signupPlan      Plan?     @map("signup_plan")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  // Collected during onboarding (personal profile)
  jobRole               String?   @map("job_role")
  phone                 String?
  goals                 String[]  @default([])
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(6)

  /// The workspace the user signs in to; access tokens are issued for it.
  lastActiveOrganizationId String? @map("last_active_organization_id") @db.Uuid

  // Profile & preferences (M05)
  avatarFileId String? @map("avatar_file_id") @db.Uuid
  /// Personal override of the workspace time zone
  timezone     String?
  locale       String?
  quietHours   Json?    @map("quiet_hours")
  digestEnabled Boolean @default(true) @map("digest_enabled")

  // Consent records (M05) — versions are the `updated` dates of the published documents
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(6)
  termsVersion    String?   @map("terms_version")
  privacyVersion  String?   @map("privacy_version")

  // Two-factor authentication (M05). Secrets are AES-256-GCM encrypted (lib/crypto.js).
  twoFactorEnabledAt        DateTime? @map("two_factor_enabled_at") @db.Timestamptz(6)
  twoFactorSecretEnc        String?   @map("two_factor_secret_enc")
  /// Secret generated by "set up 2FA", until confirmed with a valid code
  twoFactorPendingSecretEnc String?   @map("two_factor_pending_secret_enc")
  /// Last TOTP time-step accepted — a code can't be used twice
  twoFactorLastStep         BigInt?   @map("two_factor_last_step")

  // Login lockout (M05)
  failedLoginCount Int       @default(0) @map("failed_login_count")
  failedLoginSince DateTime? @map("failed_login_since") @db.Timestamptz(6)
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)

  /// New address awaiting confirmation (M05 change email)
  pendingEmail String?   @map("pending_email")
  /// Set when the user deletes their account; personal data is anonymised at the same time.
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens          RefreshToken[]
  userTokens             UserToken[]
  files                  File[]
  memberships            Membership[]
  notifications          Notification[]
  notificationPreferences NotificationPreference[]
  notificationReceipts   NotificationReceipt[]
  notificationBatches    NotificationEmailBatch[]
  notificationTickets    NotificationStreamTicket[]
  facebookConnections FacebookConnection[]
  facebookOAuthStates FacebookOAuthState[]
  facebookAssignedForms FacebookForm[]
  recoveryCodes          RecoveryCode[]
  inboundMessages        InboundMessage[]
  lastActiveOrganization Organization?  @relation("LastActiveOrganization", fields: [lastActiveOrganizationId], references: [id], onDelete: SetNull)

  @@map("users")
}

// ---------- Workspaces (M02) ----------

enum MemberRole {
  owner
  admin
  manager
  sales_rep
  viewer
}

enum MemberStatus {
  active
  invited
  deactivated
}

/// A workspace. Every CRM record belongs to exactly one organization.
model Organization {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  /// URL-safe, unique, 3–40 chars [a-z0-9-]
  slug                    String    @unique
  industry                String?
  teamSize                String?   @map("team_size")
  logoFileId              String?   @map("logo_file_id") @db.Uuid
  timezone                String    @default("Asia/Kolkata")
  country                 String    @default("IN") @db.Char(2)
  /// GST state code, e.g. "29" for Karnataka
  stateCode               String?   @map("state_code")
  currency                String    @default("INR") @db.Char(3)
  locale                  String    @default("en-IN")
  fiscalYearStartMonth    Int       @default(4) @map("fiscal_year_start_month")
  gstin                   String?
  legalName               String?   @map("legal_name")
  /// { line1, line2, city, pincode }
  address                 Json?
  plan                    Plan      @default(starter)
  /// End of the free trial (end of day, workspace time zone). Kept after expiry for history.
  trialEndsAt             DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  /// Trial reminder emails already sent, keyed "<stage>:<trial end date>" so an extension re-arms them (M06)
  trialRemindersSent      String[]  @default([]) @map("trial_reminders_sent")
  /// Set when a downgrade left more members than the plan allows; the owner must choose who stays (M06)
  seatSelectionRequiredAt DateTime? @map("seat_selection_required_at") @db.Timestamptz(6)
  /// When the owner last resolved a seat selection
  seatSuspendedResolvedAt DateTime? @map("seat_suspended_resolved_at") @db.Timestamptz(6)
  /// Members must have 2FA enabled to use this workspace (M05)
  require2fa              Boolean   @default(false) @map("require_2fa")
  createdById             String    @map("created_by_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  memberships     Membership[]
  files           File[]
  invitations     Invitation[]
  teams           Team[]
  lastActiveUsers User[]                  @relation("LastActiveOrganization")
  usage           OrganizationUsage?
  planChanges     PlanChange[]
  companies       Company[]
  contacts        Contact[]
  tags            Tag[]
  customFields    CustomFieldDefinition[]
  leadSources     LeadSource[]
  lostReasons     LostReason[]
  leads           Lead[]
  campaigns       Campaign[]
  savedViews      SavedView[]
  pipelines       Pipeline[]
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  notifications   Notification[]
  notificationPreferences NotificationPreference[]
  notificationReceipts NotificationReceipt[]
  notificationBatches NotificationEmailBatch[]
  notificationTickets NotificationStreamTicket[]

  /// Trial expiry and reminder scans
  @@index([trialEndsAt])
  @@map("organizations")
  fileLinks FileLink[]
  importJobs ImportJob[]
  importRecords ImportRecord[]
  importMappings ImportMapping[]
  exportJobs ExportJob[]
  facebookConnection FacebookConnection?
  facebookOAuthStates FacebookOAuthState[]
  facebookPages FacebookPage[]
  facebookForms FacebookForm[]
  facebookDeliveries FacebookLeadDelivery[]

}

// ---------- Plans & entitlements (M06) ----------

/// Usage shown on Settings → Plan. A display cache refreshed by events and nightly — limits are
/// always enforced by counting live (services/entitlements.service.js).
model OrganizationUsage {
  organizationId String   @id @map("organization_id") @db.Uuid
  users          Int      @default(0)
  records        Int      @default(0)
  pipelines      Int      @default(0)
  storageBytes   BigInt   @default(0) @map("storage_bytes")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_usage")
}

/// History of a workspace's plan.
model PlanChange {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  fromPlan       Plan?    @map("from_plan")
  toPlan         Plan     @map("to_plan")
  /// signup | trial_expired | trial_extended | upgrade | downgrade | staff
  reason         String
  actorId        String?  @map("actor_id") @db.Uuid
  /// Extra context, e.g. { trialEndsAt } or { days }
  meta           Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("plan_changes")
}

/// A user's place in a workspace.
model Membership {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  userId               String       @map("user_id") @db.Uuid
  role                 MemberRole   @default(sales_rep)
  status               MemberStatus @default(active)
  /// Job title shown in the team list
  title                String?
  joinedAt             DateTime?    @map("joined_at") @db.Timestamptz(6)
  deactivatedAt        DateTime?    @map("deactivated_at") @db.Timestamptz(6)
  /// When this member hid the "Get started" checklist on the app home page (M03).
  dismissedChecklistAt DateTime?    @map("dismissed_checklist_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

/// Single-use 2FA backup codes. Only SHA-256 hashes are stored; shown to the user once.
model RecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

// ---------- Team (M04) ----------

/// An emailed invitation to join a workspace. Only the token hash is stored.
model Invitation {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  email          String
  role           MemberRole
  teamIds        String[]   @map("team_ids") @db.Uuid
  tokenHash      String     @unique @map("token_hash")
  invitedById    String     @map("invited_by_id") @db.Uuid
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(6)
  lastSentAt     DateTime   @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  acceptedAt     DateTime?  @map("accepted_at") @db.Timestamptz(6)
  acceptedById   String?    @map("accepted_by_id") @db.Uuid
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, createdAt])
  @@map("invitations")
}

/// A group of members. Managers of a team see records owned by its members.
model Team {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@unique([organizationId, name])
  @@map("teams")
}

model TeamMember {
  teamId    String  @map("team_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isManager Boolean @default(false) @map("is_manager")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// One row per issued refresh token. Only the SHA-256 hash of the token is stored.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// The token that replaced this one when it was rotated.
  replacedById String?   @unique @map("replaced_by") @db.Uuid
  /// Shared by every token in one rotation chain = one signed-in device/browser (M05 sessions).
  sessionId    String    @map("session_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Single-use tokens sent by email (verification, password reset). Only the SHA-256 hash is stored.
model UserToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      UserTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(6)
  /// Extra data for the token type (see UserTokenType)
  payload   Json?
  /// Failed uses (login challenges allow 5)
  attempts  Int           @default(0)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

/// Metadata for objects in Neon Object Storage. The bytes live in the bucket; the key lives here.
model File {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("uploaded_by_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  storageKey     String   @unique @map("storage_key")
  originalName   String   @map("original_name")
  contentType    String   @map("content_type")
  sizeBytes      BigInt   @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "files_user_id_fkey")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status String @default("ready")
  sha256 String?
  scanStatus String @default("not_scanned") @map("scan_status")
  thumbnailKey String? @map("thumbnail_key")
  thumbnailBytes BigInt @default(0) @map("thumbnail_bytes")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  links FileLink[]

  @@index([userId, createdAt(sort: Desc)], map: "files_user_id_created_at_idx")
  @@index([organizationId])
  @@map("files")
  imports ImportJob[] @relation("ImportSource")
  importReports ImportJob[] @relation("ImportErrorReport")
  exports ExportJob[]

}

// ---------- Platform infrastructure (M00) ----------

/// Transactional outbox: written in the same transaction as the change it describes, then
/// dispatched to subscribers by the worker (src/events/dispatcher.js). Processed at least once.
model DomainEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nullable until organizations exist (M02).
  organizationId String?   @map("organization_id") @db.Uuid
  /// "<entity>.<past-tense verb>", e.g. "lead.created"
  type           String
  entityType     String    @map("entity_type")
  entityId       String    @map("entity_id") @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  payload        Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(6)
  /// Lease held by the dispatcher instance processing this event; also used as the retry-after time.
  claimedUntil   DateTime? @map("claimed_until") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")

  @@index([processedAt, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("domain_events")
}

/// Who did what, for security-relevant and data-changing actions. Append-only.
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// user | api_key | system
  actorType      String   @default("user") @map("actor_type")
  /// e.g. "auth.login", "lead.delete"
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  changes        Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

/// Liveness of background worker processes, reported by GET /api/health.
model WorkerHeartbeat {
  id         String   @id
  startedAt  DateTime @map("started_at") @db.Timestamptz(6)
  lastBeatAt DateTime @map("last_beat_at") @db.Timestamptz(6)
  pid        Int?
  host       String?

  @@map("worker_heartbeats")
}

// ---------- Marketing site forms (M01) ----------

enum InboundStatus {
  new
  in_progress
  closed
  spam
}

enum NewsletterStatus {
  pending
  confirmed
  unsubscribed
}

/// Submissions from the /contact page.
model ContactRequest {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Human-friendly reference shown to the submitter, e.g. "TS-482913".
  ticketNo    String        @unique @map("ticket_no")
  name        String
  email       String
  company     String?
  phone       String?
  topic       String
  message     String
  status      InboundStatus @default(new)
  /// The exact consent wording the submitter agreed to (DPDP consent record).
  consentText String        @map("consent_text")
  consentAt   DateTime      @map("consent_at") @db.Timestamptz(6)
  /// ip, userAgent, pageUrl, referrer, utm
  meta        Json          @default("{}")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  messages    InboundMessage[]

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_requests")
}

/// Bookings from the /demo page.
model DemoRequest {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  confirmationId String        @unique @map("confirmation_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String
  phone          String
  company        String
  companySize    String        @map("company_size")
  role           String
  interests      String[]
  /// UTC instant of the booked IST slot.
  slotStart      DateTime      @map("slot_start") @db.Timestamptz(6)
  notes          String?
  status         InboundStatus @default(new)
  meta           Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  messages       InboundMessage[]

  @@index([slotStart])
  @@index([status, createdAt(sort: Desc)])
  @@map("demo_requests")
}

/// Staff-only conversation history. Exactly one request FK is required by a SQL CHECK.
model InboundMessage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactRequestId String?  @map("contact_request_id") @db.Uuid
  demoRequestId    String?  @map("demo_request_id") @db.Uuid
  authorId         String?  @map("author_id") @db.Uuid
  /// note | reply
  kind             String
  body             String   @db.VarChar(10000)
  /// pending | sent | failed; null for private notes
  deliveryStatus   String?  @map("delivery_status")
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contactRequest ContactRequest? @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  demoRequest    DemoRequest? @relation(fields: [demoRequestId], references: [id], onDelete: Cascade)
  author         User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([contactRequestId, createdAt])
  @@index([demoRequestId, createdAt])
  @@index([authorId])
  @@map("inbound_messages")
}

/// Newsletter list with double opt-in. Tokens: only the confirm token is hashed (it grants a state
/// change once); the unsubscribe token is stored as-is because it must be embedded in every email.
model NewsletterSubscriber {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String           @unique
  status           NewsletterStatus @default(pending)
  confirmTokenHash String?          @unique @map("confirm_token_hash")
  confirmExpiresAt DateTime?        @map("confirm_expires_at") @db.Timestamptz(6)
  confirmSentAt    DateTime?        @map("confirm_sent_at") @db.Timestamptz(6)
  unsubscribeToken String           @unique @map("unsubscribe_token")
  confirmedAt      DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  unsubscribedAt   DateTime?        @map("unsubscribed_at") @db.Timestamptz(6)
  meta             Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("newsletter_subscribers")
}

// ---------- Companies, contacts, tags & custom fields (M07) ----------

/// An account: a business you sell to. Doesn't count toward the plan's `records` limit.
model Company {
  importId String? @map("import_id") @db.Uuid
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String
  /// Normalised: lowercase, no scheme, no "www.", no path
  domain          String?
  industry        String?
  size            String?
  gstin           String?
  phoneE164       String?   @map("phone_e164")
  phoneRaw        String?   @map("phone_raw")
  email           String?
  website         String?
  /// { line1, line2, city, stateCode, pincode, country }
  billingAddress  Json?     @map("billing_address")
  shippingAddress Json?     @map("shipping_address")
  ownerId         String?   @map("owner_id") @db.Uuid
  customFields    Json      @default("{}") @map("custom_fields")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  mergedIntoId    String?   @map("merged_into_id") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactCompany[]

  @@index([organizationId, ownerId])
  @@index([organizationId, domain])
  @@index([organizationId, gstin])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("companies")
  @@index([organizationId, importId])
}

/// A person. Counts toward the plan's `records` limit (with leads).
model Contact {
  importId String? @map("import_id") @db.Uuid
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  /// "First Last", or the primary email/phone when there's no name
  displayName      String    @map("display_name")
  title            String?
  /// [{ value, label, primary }]
  emails           Json      @default("[]")
  /// [{ e164, raw, label, primary, whatsapp }]
  phones           Json      @default("[]")
  primaryEmail     String?   @map("primary_email")
  primaryPhoneE164 String?   @map("primary_phone_e164")
  /// subscriber | lead | customer | inactive
  lifecycleStage   String    @default("lead") @map("lifecycle_stage")
  whatsappOptInAt  DateTime? @map("whatsapp_opt_in_at") @db.Timestamptz(6)
  emailOptInAt     DateTime? @map("email_opt_in_at") @db.Timestamptz(6)
  optOutAt         DateTime? @map("opt_out_at") @db.Timestamptz(6)
  /// Where the consent above came from (form, import, verbal, …)
  consentSource    String?   @map("consent_source")
  source           String?
  ownerId          String?   @map("owner_id") @db.Uuid
  customFields     Json      @default("{}") @map("custom_fields")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  createdById      String?   @map("created_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneLookups ContactPhone[]
  emailLookups ContactEmail[]
  companies    ContactCompany[]

  @@index([organizationId, ownerId])
  @@index([organizationId, primaryPhoneE164])
  @@index([organizationId, primaryEmail])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("contacts")
  @@index([organizationId, importId])
}

/// Every phone of every contact, for duplicate lookup and search. Kept in sync by contact.service.
model ContactPhone {
  organizationId String @map("organization_id") @db.Uuid
  contactId      String @map("contact_id") @db.Uuid
  e164           String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([contactId, e164])
  @@index([organizationId, e164])
  @@map("contact_phones")
}

/// Every email of every contact, for duplicate lookup and search.
model ContactEmail {
  organizationId String @map("organization_id") @db.Uuid
  contactId      String @map("contact_id") @db.Uuid
  email          String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([contactId, email])
  @@index([organizationId, email])
  @@map("contact_emails")
}

model ContactCompany {
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  /// Job role at this company, e.g. "Purchase head"
  role           String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([contactId, companyId])
  @@index([organizationId, companyId])
  @@map("contact_companies")
}

/// Workspace-level label for contacts, companies, leads and deals.
model Tag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  /// Palette name used by the UI: zinc, brand, emerald, amber, red, violet, sky, pink
  color          String   @default("zinc")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records      RecordTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

/// Polymorphic tag ↔ record join. entityType: contact | company | lead | deal
model RecordTag {
  organizationId String   @map("organization_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("record_tags")
}

/// A custom field on contacts, companies, leads or deals. Values live in each record's custom_fields JSONB.
model CustomFieldDefinition {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// contact | company | lead | deal
  entityType     String    @map("entity_type")
  /// snake_case, immutable — the key in custom_fields
  key            String
  label          String
  /// text | textarea | number | currency | date | datetime | select | multiselect | checkbox | url | email | phone | user
  type           String
  /// select/multiselect: [{ value, label, color? }]
  options        Json?
  required       Boolean   @default(false)
  position       Int       @default(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType, position])
  @@map("custom_field_definitions")
}

// ---------- Leads (M08) ----------

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
  junk
}

/// Where leads come from. System sources (used by connectors) can be renamed or archived, not deleted.
model LeadSource {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  /// Stable identifier for connectors, e.g. "indiamart"
  key            String?
  isSystem       Boolean   @default(false) @map("is_system")
  /// Fit points this source adds to the lead score
  scoreWeight    Int       @default(5) @map("score_weight")
  position       Int       @default(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, name])
  @@unique([organizationId, key])
  @@map("lead_sources")
}

/// Why a lead (or, from M09, a deal) was lost.
model LostReason {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// lead | deal
  entityType     String    @map("entity_type")
  name           String
  position       Int       @default(0)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, entityType, name])
  @@map("lost_reasons")
}

/// An unqualified enquiry. Converts into a contact (+ company, + deal from M09).
model Lead {
  campaignId String? @map("campaign_id") @db.Uuid
  campaign Campaign? @relation(fields: [organizationId, campaignId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  facebookDeliveries FacebookLeadDelivery[]
  importId String? @map("import_id") @db.Uuid
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String     @map("organization_id") @db.Uuid
  firstName          String?    @map("first_name")
  lastName           String?    @map("last_name")
  displayName        String     @map("display_name")
  emails             Json       @default("[]")
  phones             Json       @default("[]")
  primaryEmail       String?    @map("primary_email")
  primaryPhoneE164   String?    @map("primary_phone_e164")
  companyName        String?    @map("company_name")
  requirement        String?
  /// Structured qualification facts for the lead workspace; bounded and validated on writes.
  qualification      Json       @default("{}")
  budgetMinor        BigInt?    @map("budget_minor")
  city               String?
  stateCode          String?    @map("state_code")
  pincode            String?
  sourceId           String?    @map("source_id") @db.Uuid
  /// e.g. campaign name or IndiaMART query id
  sourceDetail       String?    @map("source_detail")
  utm                Json?
  status             LeadStatus @default(new)
  lostReasonId       String?    @map("lost_reason_id") @db.Uuid
  lostNote           String?    @map("lost_note")
  /// spam | wrong_number | test | duplicate | other (status junk)
  junkReason         String?    @map("junk_reason")
  score              Int        @default(0)
  scoreBreakdown     Json?      @map("score_breakdown")
  ownerId            String?    @map("owner_id") @db.Uuid
  assignedAt         DateTime?  @map("assigned_at") @db.Timestamptz(6)
  firstRespondedAt   DateTime?  @map("first_responded_at") @db.Timestamptz(6)
  lastActivityAt     DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  enquiryCount       Int        @default(1) @map("enquiry_count")
  /// Existing customer who enquired again
  contactId          String?    @map("contact_id") @db.Uuid
  isExistingCustomer Boolean    @default(false) @map("is_existing_customer")
  previousLeadId     String?    @map("previous_lead_id") @db.Uuid
  convertedAt        DateTime?  @map("converted_at") @db.Timestamptz(6)
  convertedById      String?    @map("converted_by_id") @db.Uuid
  convertedContactId String?    @map("converted_contact_id") @db.Uuid
  convertedCompanyId String?    @map("converted_company_id") @db.Uuid
  convertedDealId    String?    @map("converted_deal_id") @db.Uuid
  customFields       Json       @default("{}") @map("custom_fields")
  /// null when created by a connector or web form
  createdById        String?    @map("created_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  lostReason   LostReason?  @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  phoneLookups LeadPhone[]
  emailLookups LeadEmail[]

  // Partial covering index leads_live_status_idx is managed in SQL (20261022173000),
  // alongside the existing SQL-only partial/trigram indexes. Excludes deleted rows.
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, primaryPhoneE164])
  @@index([organizationId, primaryEmail])
  @@index([organizationId, sourceId])
  @@index([organizationId, campaignId])
  @@map("leads")
  @@index([organizationId, importId])
}

/// Workspace marketing campaigns. Metrics are aggregated from attributed CRM records.
model Campaign {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(160)
  code String @db.VarChar(80)
  type String @db.VarChar(20)
  objective String @db.VarChar(30)
  status String @default("draft") @db.VarChar(20)
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  budgetMinor BigInt? @map("budget_minor")
  actualSpendMinor BigInt? @map("actual_spend_minor")
  currency String @db.Char(3)
  sourceId String? @map("source_id") @db.Uuid
  ownerId String? @map("owner_id") @db.Uuid
  externalAccountId String? @map("external_account_id") @db.VarChar(100)
  externalCampaignId String? @map("external_campaign_id") @db.VarChar(100)
  externalPlatform String? @map("external_platform") @db.VarChar(20)
  landingUrl String? @map("landing_url") @db.VarChar(2000)
  targetAudience String? @map("target_audience") @db.VarChar(2000)
  description String? @db.VarChar(10000)
  utm Json @default("{}")
  createdById String? @map("created_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads Lead[]
  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@unique([organizationId, externalPlatform, externalCampaignId])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("campaigns")
}

model LeadPhone {
  organizationId String @map("organization_id") @db.Uuid
  leadId         String @map("lead_id") @db.Uuid
  e164           String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, e164])
  @@index([organizationId, e164])
  @@map("lead_phones")
}

model LeadEmail {
  organizationId String @map("organization_id") @db.Uuid
  leadId         String @map("lead_id") @db.Uuid
  email          String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, email])
  @@index([organizationId, email])
  @@map("lead_emails")
}

/// A saved list filter: personal, or shared with the whole workspace.
model SavedView {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// Creator; personal views are only listed for them
  userId         String   @map("user_id") @db.Uuid
  /// lead | contact | company | deal
  entityType     String   @map("entity_type")
  name           String
  /// The list's query params, e.g. { status: "new,contacted", ownerId: "me" }
  filters        Json     @default("{}")
  columns        Json     @default("[]")
  isShared       Boolean  @default(false) @map("is_shared")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType])
  @@map("saved_views")
}

// ---------- Pipelines & deals (M09) ----------

enum DealStatus {
  open
  won
  lost
}

enum StageType {
  open
  won
  lost
}

/// A sales pipeline. Limited per plan (`pipelines`). Exactly one is the default.
model Pipeline {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean   @default(false) @map("is_default")
  position       Int       @default(0)
  /// Template it was created from (config/pipelineTemplates.js)
  templateKey    String?   @map("template_key")
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  deals        Deal[]

  @@index([organizationId, position])
  @@map("pipelines")
}

/// A stage. Every pipeline has exactly one Won and one Lost stage, always last.
model PipelineStage {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  pipelineId     String    @map("pipeline_id") @db.Uuid
  name           String
  type           StageType @default(open)
  position       Int       @default(0)
  /// Win probability 0–100, for the weighted forecast
  probability    Int       @default(0)
  /// Days without activity before an open deal is "rotting"; null = off
  rottingDays    Int?      @map("rotting_days")
  /// Fields a deal must have before entering: core keys (valueMinor, expectedCloseDate, companyId, contacts) or "cf.<key>"
  requiredFields String[]  @default([]) @map("required_fields")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, position])
  @@index([organizationId])
  @@map("pipeline_stages")
}

model Deal {
  importId String? @map("import_id") @db.Uuid
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  title               String
  pipelineId          String     @map("pipeline_id") @db.Uuid
  stageId             String     @map("stage_id") @db.Uuid
  status              DealStatus @default(open)
  valueMinor          BigInt     @default(0) @map("value_minor")
  currency            String     @db.Char(3)
  probabilityOverride Int?       @map("probability_override")
  expectedCloseDate   DateTime?  @map("expected_close_date") @db.Date
  companyId           String?    @map("company_id") @db.Uuid
  leadId              String?    @map("lead_id") @db.Uuid
  sourceId            String?    @map("source_id") @db.Uuid
  ownerId             String?    @map("owner_id") @db.Uuid
  /// Manual order within a stage (ascending); new deals go to the top
  position            Float      @default(0)
  stageEnteredAt      DateTime   @default(now()) @map("stage_entered_at") @db.Timestamptz(6)
  lastActivityAt      DateTime   @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  /// Set by deals.rotting_scan; compared with stage_entered_at so `deal.rotting` fires once per stage entry
  rottingNotifiedAt   DateTime?  @map("rotting_notified_at") @db.Timestamptz(6)
  wonAt               DateTime?  @map("won_at") @db.Timestamptz(6)
  lostAt              DateTime?  @map("lost_at") @db.Timestamptz(6)
  closedAt            DateTime?  @map("closed_at") @db.Timestamptz(6)
  lostReasonId        String?    @map("lost_reason_id") @db.Uuid
  lostNote            String?    @map("lost_note")
  customFields        Json       @default("{}") @map("custom_fields")
  createdById         String?    @map("created_by_id") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline           @relation(fields: [pipelineId], references: [id])
  stage        PipelineStage      @relation(fields: [stageId], references: [id])
  contacts     DealContact[]
  history      DealStageHistory[]

  @@index([organizationId, pipelineId, stageId])
  @@index([organizationId, ownerId, status])
  @@index([organizationId, status, closedAt])
  @@index([organizationId, companyId])
  @@map("deals")
  @@index([organizationId, importId])
}

model DealContact {
  organizationId String   @map("organization_id") @db.Uuid
  dealId         String   @map("deal_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  /// e.g. Decision maker, Influencer, Consultant
  role           String?
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@index([organizationId, contactId])
  @@map("deal_contacts")
}

model DealStageHistory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  dealId             String   @map("deal_id") @db.Uuid
  fromStageId        String?  @map("from_stage_id") @db.Uuid
  toStageId          String   @map("to_stage_id") @db.Uuid
  fromPipelineId     String?  @map("from_pipeline_id") @db.Uuid
  toPipelineId       String   @map("to_pipeline_id") @db.Uuid
  movedById          String?  @map("moved_by_id") @db.Uuid
  movedAt            DateTime @default(now()) @map("moved_at") @db.Timestamptz(6)
  secondsInPrevStage Int?     @map("seconds_in_prev_stage")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([organizationId, toStageId, movedAt])
  @@index([dealId, movedAt])
  @@map("deal_stage_history")
}

// ---------- Activities, tasks & timeline (M10) ----------

enum ActivityType {
  note
  call
  meeting
  site_visit
  whatsapp
  email
  sms
  system
}

enum TaskStatus {
  open
  completed
  cancelled
}

/// Something that happened on a record: a note, a logged call/meeting/visit/message, or a system event.
model Activity {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  type            ActivityType
  /// Primary record: lead | contact | company | deal
  entityType      String       @map("entity_type")
  entityId        String       @map("entity_id") @db.Uuid
  subject         String?
  /// Notes / meeting notes: limited Markdown, HTML stripped
  body            String?
  occurredAt      DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  endAt           DateTime?    @map("end_at") @db.Timestamptz(6)
  /// inbound | outbound
  direction       String?
  /// Calls: connected | no_answer | busy | wrong_number | callback_requested | voicemail
  outcome         String?
  durationSeconds Int?         @map("duration_seconds")
  /// { text, lat?, lng? }
  location        Json?
  /// System events: { event, changes, … }; channels: message ids
  meta            Json         @default("{}")
  isPinned        Boolean      @default(false) @map("is_pinned")
  actorId         String?      @map("actor_id") @db.Uuid
  /// Domain event that produced a system activity (idempotency)
  sourceEventId   String?      @unique @map("source_event_id") @db.Uuid
  editedAt        DateTime?    @map("edited_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links        ActivityLink[]
  participants ActivityParticipant[]
  mentions     Mention[]

  @@index([organizationId, entityType, entityId, occurredAt(sort: Desc)])
  @@map("activities")
}

/// Every record an activity shows on (its primary record plus related ones) — the timeline index.
model ActivityLink {
  activityId     String   @map("activity_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  /// Copy of activity.occurred_at for ordering the timeline without a join
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([activityId, entityType, entityId])
  @@index([organizationId, entityType, entityId, occurredAt(sort: Desc)])
  @@map("activity_links")
}

/// Who took part in a meeting/visit: members and/or contacts.
model ActivityParticipant {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
